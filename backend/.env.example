# EnergyScope backend - environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

PORT=3001

# Existing secrets (already required by server.js)
JWT_SECRET=change-me
SESSION_ENCRYPTION_KEY=change-me-64-hex-chars

# --- Solar archive collector (new) ---------------------------------------
# UTL portal credentials used ONLY by the headless archive collector
# (scripts/archive-collector.js). They are stored encrypted in the existing
# sessions table via SESSION_ENCRYPTION_KEY and are never exposed to the
# frontend. If unset, collection fails fast with a clear error.
UTL_COLLECTOR_EMAIL=
UTL_COLLECTOR_PASSWORD=

# Plant to archive. Current plant: 105717
ARCHIVE_PLANT_ID=105717

# Optional earliest calendar day that should exist in the archive. The
# scheduled gap-aware collector scans ARCHIVE_START_DATE..yesterday (IST) and
# backfills every missing day it can. When unset, the scan starts at the
# earliest day already archived (no historical backfill beyond current
# coverage). Format: YYYY-MM-DD
# ARCHIVE_START_DATE=

# Optional override of the SQLite file location (default: data/archive.db)
# ARCHIVE_DB_PATH=

# Python executable path. Default: python3 (Oracle Ubuntu has python3 but not python).
# PYTHON_BIN=python3

# --- AI chatbot (Gemini) ---------------------------------------------------
# Google Gemini API key. Server-side ONLY - never exposed to the frontend and
# never logged. Without a key, /api/ai/chat returns a clear "not configured"
# error instead of failing.
GEMINI_API_KEY=

# Optional model override. Default: gemini-3.6-flash (Google retired
# gemini-2.5-flash for new API keys). Must be available to the key's project
# on the Generative Language API - check with ListModels if unsure.
# GEMINI_MODEL=gemini-3.6-flash

# Optional per-request timeout in milliseconds (default: 30000).
# GEMINI_TIMEOUT_MS=30000

# Optional max output tokens (default: 1024).
# GEMINI_MAX_OUTPUT_TOKENS=1024

# --- AI chatbot (Groq) ------------------------------------------------------
# Groq API key. Server-side ONLY - never exposed to the frontend and
# never logged. Without a key, /api/ai/chat returns a clear "not configured"
# error when AI_PROVIDER=groq.
GROQ_API_KEY=

# Optional model override. Default: openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional per-request timeout in milliseconds (default: 30000).
# GROQ_TIMEOUT_MS=30000

# Optional max output tokens (default: 1024).
# GROQ_MAX_OUTPUT_TOKENS=1024

# --- AI provider selection --------------------------------------------------
# Which provider to use: "groq" (default) or "gemini".
AI_PROVIDER=groq

# Optional fallback provider. When set, if the primary provider fails the
# request is retried with this provider. Leave empty for no fallback.
# AI_FALLBACK_PROVIDER=
